{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crude’s Edit Toolkit",
  "mainBinaryName": "crude-edit-toolkit",
  "version": "0.1.1",
  "identifier": "net.crudes.edittoolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crude's Edit Toolkit",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0b0b0c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/deno",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/TwitchDownloaderCLI"
    ],
    "resources": {
      "resources/exiftool/": "exiftool/",
      "resources/licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Crudes",
    "copyright": "Copyright (c) 2026 Mustafa Crude",
    "category": "Video",
    "shortDescription": "Downloads and pre-edit fixes for Premiere",
    "longDescription": "Download videos, make footage and images import cleanly into Premiere, cut parts out, and clean up pictures.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCOUYzQThERjBFQTBEQTAKUldTZ0RlcndqVHFmMjlGaHI4aUNYYUVQaUU1b1N1Z1kxRTR5TlByOHlqSlZJMEtBSXdvU2ZiT2cK",
      "endpoints": [
        "https://github.com/mustafacrude/crude-edit-toolkit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
